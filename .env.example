# Base URL of calculator_api_ts as seen from the browser (embedded at build time).
# Leave empty to use same-origin requests (dev server proxy / reverse proxy in production).
VITE_API_URL=

# Optional tuning (defaults shown).
VITE_HEALTH_POLL_INTERVAL_MS=30000
VITE_HISTORY_LIMIT=10

# Target of the Vite dev-server proxy for /api and /health (development only).
API_PROXY_TARGET=http://localhost:3000
